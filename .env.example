# Optional: override the Stud bridge URL.
# Leave unset on Vercel — the web demo will display "Studio not connected" because
# the Tauri bridge only runs locally.
# VITE_STUD_API_URL=http://localhost:3001

# Optional: use your own OpenAI OAuth client so the ChatGPT Plus/Pro sign-in
# redirect comes back to this domain (e.g. https://stud-weld.vercel.app).
#
# IMPORTANT: OpenAI's public Codex client (app_EMoamEEZ73f0CkXaXp7hrann) is
# locked to http://localhost:1455/auth/callback, so it will not redirect back
# to a deployed website. To use OAuth on a deployed site you must register
# your own OAuth client at https://platform.openai.com/ and set BOTH vars to
# values whose registered redirect matches exactly. If you do not set these,
# the web app automatically uses the device-code sign-in flow (no redirect).
# VITE_CODEX_CLIENT_ID=app_your_client_id
# VITE_CODEX_REDIRECT_URI=https://stud-weld.vercel.app/auth/callback